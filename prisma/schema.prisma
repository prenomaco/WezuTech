generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductMediaKind {
  CARD
  HERO
  DETAIL
  GALLERY
  APPLICATION
  DATASHEET
}

enum ProductSectionType {
  METRICS
  BENEFITS
  FEATURES
  ENVIRONMENTS
  CONFIGURATION
  SPECIFICATIONS
  ECOSYSTEM
  CTA
  RICH_TEXT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  SPAM
}

enum LeadEmailStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  status          ProductStatus    @default(DRAFT)
  tagline         String?
  cardDescription String?
  introduction    String?
  seoTitle        String?
  seoDescription  String?
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  media           ProductMedia[]
  sections        ProductSection[]
  leads           Lead[]
  categories      ProductCategory[]

  @@index([status, sortOrder])
}

/// One of the six application areas the site groups products by. Rows are
/// seeded rather than user-created: the set matches the home page's industries
/// section and the `/products` index, so a seventh would need artwork and copy
/// alongside it.
model Category {
  id        String            @id @default(cuid())
  slug      String            @unique
  name      String
  blurb     String
  image     String
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  products  ProductCategory[]

  @@index([sortOrder])
}

/// A product sits in as many categories as it serves — a DC fast charger is
/// both Automotive and Special Purpose Vehicles — so this is an explicit join
/// rather than a column on Product.
model ProductCategory {
  productId  String
  categoryId String
  sortOrder  Int      @default(0)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, sortOrder])
}

model ProductMedia {
  id                 String           @id @default(cuid())
  productId          String
  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind               ProductMediaKind @default(GALLERY)
  url                String
  cloudinaryPublicId String?
  alt                String
  sortOrder          Int              @default(0)
  createdAt          DateTime         @default(now())

  @@index([productId, kind, sortOrder])
}

model ProductSection {
  id        String             @id @default(cuid())
  productId String
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      ProductSectionType
  title     String?
  data      Json
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([productId, sortOrder])
}

model Lead {
  id                  String          @id @default(cuid())
  name                String
  email               String
  phone               String?
  company             String?
  subject             String?
  message             String
  sourceProductId     String?
  sourceProduct       Product?        @relation(fields: [sourceProductId], references: [id], onDelete: SetNull)
  status              LeadStatus      @default(NEW)
  internalNotes       String?
  notificationStatus  LeadEmailStatus @default(PENDING)
  notificationMessage String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([sourceProductId])
}

model Testimonial {
  id          String   @id @default(cuid())
  lead        String?
  quote       String
  client      String
  title       String
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, sortOrder])
}
